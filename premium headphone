    <!-- Three.js logic and Orchestrator script -->
    <script type="module">
        import * as THREE from 'https://esm.sh/three@0.147.0';
        import { OrbitControls } from 'https://esm.sh/three@0.147.0/examples/jsm/controls/OrbitControls.js';
        // ==========================================================================
        // 3D RENDER ENGINE (ThreeViewer)
        // ==========================================================================
        class ThreeViewer {
            constructor(containerId) {
                this.container = document.getElementById(containerId);
                if (!this.container) {
                    console.error(`Container #${containerId} not found.`);
                    return;
                }
                this.width = this.container.clientWidth;
                this.height = this.container.clientHeight || 500;
                this.autoRotate = true;
                this.isLoaded = false;
                
                this.materials = {};
                
                this.init();
            }
            init() {
                this.scene = new THREE.Scene();
                this.scene.fog = new THREE.FogExp2(0x080a0f, 0.05);
                this.camera = new THREE.PerspectiveCamera(40, this.width / this.height, 0.1, 100);
                this.camera.position.set(0, 0, 12);
                this.renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
                this.renderer.setSize(this.width, this.height);
                this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
                this.renderer.shadowMap.enabled = true;
                this.renderer.shadowMap.type = THREE.PCFSoftShadowMap;
                this.renderer.toneMapping = THREE.ACESFilmicToneMapping;
                this.renderer.toneMappingExposure = 1.0;
                this.container.appendChild(this.renderer.domElement);
                this.controls = new OrbitControls(this.camera, this.renderer.domElement);
                this.controls.enableDamping = true;
                this.controls.dampingFactor = 0.05;
                this.controls.maxDistance = 20;
                this.controls.minDistance = 5;
                this.controls.enablePan = false;
                this.setupLights();
                this.createParticles();
                this.buildHeadset();
                window.addEventListener('resize', this.onResize.bind(this));
                this.animate();
                this.isLoaded = true;
            }
            setupLights() {
                const ambientLight = new THREE.AmbientLight(0xffffff, 0.2);
                this.scene.add(ambientLight);
                this.keyLight = new THREE.DirectionalLight(0xffffff, 1.5);
                this.keyLight.position.set(5, 8, 5);
                this.keyLight.castShadow = true;
                this.scene.add(this.keyLight);
                this.fillLight = new THREE.DirectionalLight(0xffffff, 0.8);
                this.fillLight.position.set(-5, 3, -5);
                this.scene.add(this.fillLight);
                this.backLight = new THREE.DirectionalLight(0xbd00ff, 1.2);
                this.backLight.position.set(0, -6, 2);
                this.scene.add(this.backLight);
                this.leftLedLight = new THREE.PointLight(0x00f0ff, 2.5, 6, 2);
                this.leftLedLight.position.set(-2.5, -0.5, 0);
                this.scene.add(this.leftLedLight);
                this.rightLedLight = new THREE.PointLight(0x00f0ff, 2.5, 6, 2);
                this.rightLedLight.position.set(2.5, -0.5, 0);
                this.scene.add(this.rightLedLight);
            }
            createParticles() {
                const particleCount = 200;
                const geometry = new THREE.BufferGeometry();
                const positions = new Float32Array(particleCount * 3);
                for (let i = 0; i < particleCount * 3; i += 3) {
                    positions[i] = (Math.random() - 0.5) * 20;
                    positions[i + 1] = (Math.random() - 0.5) * 15;
                    positions[i + 2] = (Math.random() - 0.5) * 15;
                }
                geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
                const material = new THREE.PointsMaterial({
                    color: 0x00f0ff,
                    size: 0.08,
                    transparent: true,
                    opacity: 0.6,
                    blending: THREE.AdditiveBlending
                });
                this.particles = new THREE.Points(geometry, material);
                this.scene.add(this.particles);
            }
            buildHeadset() {
                this.headsetGroup = new THREE.Group();
                this.scene.add(this.headsetGroup);
                this.materials.headband = new THREE.MeshStandardMaterial({ color: 0x18181b, roughness: 0.6, metalness: 0.2 });
                this.materials.headbandCushion = new THREE.MeshStandardMaterial({ color: 0x27272a, roughness: 0.8, metalness: 0.1 });
                this.materials.earcups = new THREE.MeshStandardMaterial({ color: 0xd4d4d8, roughness: 0.15, metalness: 0.95 });
                this.materials.cushions = new THREE.MeshStandardMaterial({ color: 0x18181b, roughness: 0.9, metalness: 0.05 });
                this.materials.accents = new THREE.MeshStandardMaterial({ color: 0x000000, roughness: 0.4, metalness: 0.8 });
                
                this.materials.led = new THREE.MeshStandardMaterial({
                    color: 0x000000,
                    emissive: 0x00f0ff,
                    emissiveIntensity: 3.5,
                    roughness: 0.2
                });
                // Headband
                const headbandGeo = new THREE.TorusGeometry(2.6, 0.24, 16, 64, Math.PI);
                const headbandMesh = new THREE.Mesh(headbandGeo, this.materials.headband);
                headbandMesh.rotation.z = -Math.PI / 2;
                headbandMesh.position.y = 0.8;
                headbandMesh.castShadow = true;
                this.headsetGroup.add(headbandMesh);
                // Cushion
                const cushionGeo = new THREE.TorusGeometry(2.45, 0.14, 12, 64, Math.PI);
                const cushionMesh = new THREE.Mesh(cushionGeo, this.materials.headbandCushion);
                cushionMesh.rotation.z = -Math.PI / 2;
                cushionMesh.position.y = 0.8;
                this.headsetGroup.add(cushionMesh);
                // Joints
                const jointGeo = new THREE.CylinderGeometry(0.14, 0.14, 1.2, 16);
                const leftJoint = new THREE.Mesh(jointGeo, this.materials.accents);
                leftJoint.position.set(-2.6, 0.2, 0);
                leftJoint.rotation.z = 0.1;
                this.headsetGroup.add(leftJoint);
                const rightJoint = leftJoint.clone();
                rightJoint.position.x = 2.6;
                rightJoint.rotation.z = -0.1;
                this.headsetGroup.add(rightJoint);
                // Earcups
                const earcupGeo = new THREE.CylinderGeometry(1.15, 1.15, 0.7, 32);
                earcupGeo.rotateZ(Math.PI / 2);
                
                this.leftEarcup = new THREE.Mesh(earcupGeo, this.materials.earcups);
                this.leftEarcup.position.set(-2.75, -0.5, 0);
                this.leftEarcup.castShadow = true;
                this.headsetGroup.add(this.leftEarcup);
                this.rightEarcup = new THREE.Mesh(earcupGeo, this.materials.earcups);
                this.rightEarcup.position.set(2.75, -0.5, 0);
                this.rightEarcup.castShadow = true;
                this.headsetGroup.add(this.rightEarcup);
                // Cushion pads
                const padGeo = new THREE.CylinderGeometry(1.2, 1.2, 0.35, 32);
                padGeo.rotateZ(Math.PI / 2);
                const leftPad = new THREE.Mesh(padGeo, this.materials.cushions);
                leftPad.position.set(-2.4, -0.5, 0);
                this.headsetGroup.add(leftPad);
                const rightPad = new THREE.Mesh(padGeo, this.materials.cushions);
                rightPad.position.set(2.4, -0.5, 0);
                this.headsetGroup.add(rightPad);
                // Glowing LEDs
                const ledRingGeo = new THREE.TorusGeometry(0.85, 0.06, 16, 64);
                ledRingGeo.rotateY(Math.PI / 2);
                this.leftLedRing = new THREE.Mesh(ledRingGeo, this.materials.led);
                this.leftLedRing.position.set(-3.12, -0.5, 0);
                this.headsetGroup.add(this.leftLedRing);
                this.rightLedRing = new THREE.Mesh(ledRingGeo, this.materials.led);
                this.rightLedRing.position.set(3.12, -0.5, 0);
                this.headsetGroup.add(this.rightLedRing);
                // Caps
                const capGeo = new THREE.CylinderGeometry(0.6, 0.6, 0.1, 32);
                capGeo.rotateZ(Math.PI / 2);
                const leftCap = new THREE.Mesh(capGeo, this.materials.accents);
                leftCap.position.set(-3.14, -0.5, 0);
                this.headsetGroup.add(leftCap);
                const rightCap = new THREE.Mesh(capGeo, this.materials.accents);
                rightCap.position.set(3.14, -0.5, 0);
                this.headsetGroup.add(rightCap);
                this.headsetGroup.rotation.x = 0.15;
                this.headsetGroup.rotation.y = -0.3;
            }
            updateModelParts(config) {
                if (!this.isLoaded) return;
                const { finish, earcupColor, headbandColor, ledColor } = config;
                if (finish === 'metallic') {
                    this.materials.earcups.metalness = 0.95;
                    this.materials.earcups.roughness = 0.15;
                    this.materials.accents.metalness = 0.8;
                    this.materials.accents.roughness = 0.3;
                } else if (finish === 'matte') {
                    this.materials.earcups.metalness = 0.1;
                    this.materials.earcups.roughness = 0.75;
                    this.materials.accents.metalness = 0.05;
                    this.materials.accents.roughness = 0.6;
                } else if (finish === 'cyberpunk') {
                    this.materials.earcups.metalness = 0.75;
                    this.materials.earcups.roughness = 0.3;
                    this.materials.accents.metalness = 0.9;
                    this.materials.accents.roughness = 0.05;
                }
                if (earcupColor) {
                    this.materials.earcups.color.setHex(parseInt(earcupColor.replace('#', '0x')));
                }
                if (headbandColor) {
                    this.materials.headband.color.setHex(parseInt(headbandColor.replace('#', '0x')));
                    this.materials.headbandCushion.color.setHex(parseInt(headbandColor.replace('#', '0x')));
                    this.materials.headbandCushion.color.multiplyScalar(0.7);
                }
                if (ledColor) {
                    const hexVal = parseInt(ledColor.replace('#', '0x'));
                    this.materials.led.emissive.setHex(hexVal);
                    this.leftLedLight.color.setHex(hexVal);
                    this.rightLedLight.color.setHex(hexVal);
                    this.backLight.color.setHex(hexVal);
                    this.particles.material.color.setHex(hexVal);
                }
            }
            resetCamera() {
                this.camera.position.set(0, 0, 12);
                this.controls.target.set(0, 0, 0);
                this.headsetGroup.rotation.set(0.15, -0.3, 0);
            }
            animate() {
                requestAnimationFrame(this.animate.bind(this));
                if (this.autoRotate) {
                    this.headsetGroup.rotation.y += 0.006;
                }
                if (this.particles) {
                    this.particles.rotation.y -= 0.001;
                    this.particles.rotation.x += 0.0005;
                }
                this.controls.update();
                this.renderer.render(this.scene, this.camera);
            }
            onResize() {
                this.width = this.container.clientWidth;
                this.height = this.container.clientHeight || 500;
                this.camera.aspect = this.width / this.height;
                this.camera.updateProjectionMatrix();
                this.renderer.setSize(this.width, this.height);
            }
        }
        // ==========================================================================
        // APPLICATION CONTROLLER (App)
        // ==========================================================================
        const EARCUP_COLORS = [
            { name: 'Cyber Silver', hex: '#d4d4d8' },
