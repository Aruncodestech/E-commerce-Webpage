        ];
        class App {
            constructor() {
                this.viewer = null;
                this.config = {
                    finish: 'metallic',
                    basePrice: 299,
                    finishPriceAdd: 0,
                    earcup: EARCUP_COLORS[0],
                    headband: HEADBAND_COLORS[0],
                    led: LED_COLORS[0]
                };
                this.cart = this.loadCartFromStorage();
                this.init();
            }
            init() {
                this.runLoader();
                this.viewer = new ThreeViewer('canvas-3d-target');
                this.update3DViewer();
                this.renderSwatches('earcup-swatches', EARCUP_COLORS, 'earcup', this.config.earcup.hex);
                this.renderSwatches('headband-swatches', HEADBAND_COLORS, 'headband', this.config.headband.hex);
                this.renderSwatches('led-swatches', LED_COLORS, 'led', this.config.led.hex);
                this.renderCatalog();
                this.setupEventHandlers();
                this.updatePriceDisplay();
                this.updateCartUI();
                if (window.lucide) {
                    window.lucide.createIcons();
                }
            }
            runLoader() {
                const loader = document.getElementById('loader');
                const percentageText = loader.querySelector('.loader-percentage');
                const statusText = loader.querySelector('.loader-status');
                
                const phases = [
                    { limit: 25, msg: 'Calibrating Optic Matrix...' },
                    { limit: 60, msg: 'Compiling GPU Shaders...' },
                    { limit: 85, msg: 'Syncing Bluetooth Nodes...' },
                    { limit: 100, msg: 'Neural Interface Active.' }
                ];
                let percentage = 0;
                let phaseIndex = 0;
                const interval = setInterval(() => {
                    percentage += Math.floor(Math.random() * 4) + 1;
                    if (percentage >= 100) {
                        percentage = 100;
                        clearInterval(interval);
                        setTimeout(() => {
                            loader.style.opacity = '0';
                            loader.style.pointerEvents = 'none';
                        }, 400);
                    }
                    percentageText.textContent = `${percentage}%`;
                    if (percentage >= phases[phaseIndex].limit && phaseIndex < phases.length - 1) {
                        phaseIndex++;
                        statusText.textContent = phases[phaseIndex].msg;
                    }
                }, 30);
            }
            renderSwatches(containerId, options, key, currentHex) {
                const container = document.getElementById(containerId);
                if (!container) return;
                container.innerHTML = '';
                
                options.forEach(opt => {
                    const swatch = document.createElement('button');
                    swatch.className = `swatch ${opt.hex === currentHex ? 'active' : ''}`;
                    swatch.dataset.hex = opt.hex;
                    swatch.dataset.name = opt.name;
                    swatch.title = opt.name;
                    swatch.style.setProperty('--accent-active', opt.hex);
                    swatch.style.setProperty('--accent-active-glow', opt.hex + '60');
                    const inner = document.createElement('span');
                    inner.className = 'swatch-inner';
                    inner.style.backgroundColor = opt.hex;
                    
                    if (key === 'led') {
                        inner.style.boxShadow = `0 0 10px ${opt.hex}`;
                    }
                    swatch.appendChild(inner);
                    swatch.addEventListener('click', () => {
                        container.querySelectorAll('.swatch').forEach(s => s.classList.remove('active'));
                        swatch.classList.add('active');
                        this.config[key] = opt;
                        const label = document.getElementById(`selected-${key}`);
                        if (label) label.textContent = opt.name;
                        this.update3DViewer();
                    });
                    container.appendChild(swatch);
                });
            }
            renderCatalog() {
                const catalogContainer = document.getElementById('accessories-catalog');
                if (!catalogContainer) return;
                catalogContainer.innerHTML = '';
                ACCESSORIES.forEach(item => {
                    const card = document.createElement('div');
                    card.className = 'catalog-card glass';
                    card.innerHTML = `
                        <div class="card-img-wrapper">${item.svg}</div>
                        <div class="card-body">
                            <h3 class="card-title">${item.name}</h3>
                            <p class="card-desc">${item.desc}</p>
                            <div class="card-footer">
                                <span class="card-price">$${item.price}.00</span>
                                <button class="card-btn add-acc-btn" data-id="${item.id}">
                                    <i data-lucide="plus"></i>
                                </button>
                            </div>
                        </div>
                    `;
                    card.querySelector('.add-acc-btn').addEventListener('click', () => {
                        this.addToCart(item.id, item.name, item.price, 'accessory');
                    });
                    catalogContainer.appendChild(card);
                });
            }
            update3DViewer() {
                if (!this.viewer) return;
                this.viewer.updateModelParts({
                    finish: this.config.finish,
                    earcupColor: this.config.earcup.hex,
                    headbandColor: this.config.headband.hex,
                    ledColor: this.config.led.hex
                });
                document.documentElement.style.setProperty('--accent-active', this.config.led.hex);
                document.documentElement.style.setProperty('--accent-active-glow', this.config.led.hex + '55');
            }
            updatePriceDisplay() {
                const priceElement = document.getElementById('product-price');
                if (!priceElement) return;
                const finalPrice = this.config.basePrice + this.config.finishPriceAdd;
                priceElement.textContent = finalPrice;
            }
            loadCartFromStorage() {
                const saved = localStorage.getItem('aether_audio_cart_aether');
                return saved ? JSON.parse(saved) : [];
            }
            saveCartToStorage() {
                localStorage.setItem('aether_audio_cart_aether', JSON.stringify(this.cart));
            }
            addToCart(id, name, price, type) {
                let uniqueKey = id;
                if (type === 'custom') {
                    uniqueKey = `${id}-${this.config.finish}-${this.config.earcup.name.replace(' ', '')}-${this.config.headband.name.replace(' ', '')}-${this.config.led.name.replace(' ', '')}`;
                }
                const existingItem = this.cart.find(item => item.key === uniqueKey);
                if (existingItem) {
                    existingItem.quantity += 1;
                } else {
                    const newItem = {
                        key: uniqueKey,
                        id: id,
                        name: name,
                        price: price,
                        type: type,
                        quantity: 1,
                        details: type === 'custom' ? {
                            finish: this.config.finish,
                            earcup: this.config.earcup.name,
                            headband: this.config.headband.name,
                            led: this.config.led.name,
                            ledHex: this.config.led.hex
                        } : null
                    };
                    this.cart.push(newItem);
                }
                this.saveCartToStorage();
                this.updateCartUI();
                this.openCart();
            }
            changeQuantity(key, delta) {
                const item = this.cart.find(i => i.key === key);
                if (!item) return;
                item.quantity += delta;
                if (item.quantity <= 0) {
                    this.cart = this.cart.filter(i => i.key !== key);
                }
                this.saveCartToStorage();
                this.updateCartUI();
            }
            removeItem(key) {
                this.cart = this.cart.filter(i => i.key !== key);
                this.saveCartToStorage();
                this.updateCartUI();
            }
            clearCart() {
                this.cart = [];
                this.saveCartToStorage();
                this.updateCartUI();
            }
            updateCartUI() {
                const totalItemsCount = this.cart.reduce((sum, item) => sum + item.quantity, 0);
                document.querySelectorAll('.cart-count').forEach(el => {
                    el.textContent = totalItemsCount;
                });
                const list = document.getElementById('cart-items-list');
                if (!list) return;
                if (this.cart.length === 0) {
                    list.innerHTML = `
                        <div class="empty-cart-message">
                            <i data-lucide="shopping-bag"></i>
                            <p>Your audio rig is empty.</p>
                        </div>
                    `;
                } else {
                    list.innerHTML = '';
                    this.cart.forEach(item => {
                        const itemEl = document.createElement('div');
                        itemEl.className = 'cart-item';
                        let imgMarkup = '';
                        if (item.type === 'custom') {
                            imgMarkup = `
                                <div class="cart-item-img" style="border-color: ${item.details.ledHex}">
                                    <span class="logo-icon" style="color: ${item.details.ledHex}">▲</span>
                                </div>
                            `;
                        } else {
                            const accessoryItem = ACCESSORIES.find(a => a.id === item.id);
                            imgMarkup = `<div class="cart-item-img">${accessoryItem ? accessoryItem.svg : ''}</div>`;
                        }
                        let specsMarkup = item.type === 'custom' 
                            ? `<span class="cart-item-specs">${item.details.finish} // ${item.details.earcup} // LED: ${item.details.led}</span>`
                            : `<span class="cart-item-specs">Hardware Upgrade</span>`;
                        itemEl.innerHTML = `
                            ${imgMarkup}
                            <div class="cart-item-details">
                                <h4 class="cart-item-name">${item.name}</h4>
                                ${specsMarkup}
                                <span class="cart-item-price">$${item.price * item.quantity}.00</span>
                            </div>
                            <div class="cart-item-actions">
                                <div class="qty-control">
                                    <button class="qty-btn qty-minus" data-key="${item.key}">-</button>
                                    <span class="qty-val">${item.quantity}</span>
                                    <button class="qty-btn qty-plus" data-key="${item.key}">+</button>
                                </div>
                                <button class="item-delete-btn" data-key="${item.key}"><i data-lucide="trash-2"></i> Remove</button>
                            </div>
                        `;
                        itemEl.querySelector('.qty-minus').addEventListener('click', () => this.changeQuantity(item.key, -1));
                        itemEl.querySelector('.qty-plus').addEventListener('click', () => this.changeQuantity(item.key, 1));
                        itemEl.querySelector('.item-delete-btn').addEventListener('click', () => this.removeItem(item.key));
                        list.appendChild(itemEl);
                    });
                }
                const subtotal = this.cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
                document.getElementById('cart-subtotal').textContent = `$${subtotal.toFixed(2)}`;
                document.getElementById('cart-total').textContent = `$${subtotal.toFixed(2)}`;
                if (window.lucide) {
                    window.lucide.createIcons();
                }
            }
            openCart() {
                document.getElementById('cart-overlay').classList.add('open');
            }
            closeCart() {
                document.getElementById('cart-overlay').classList.remove('open');
            }
            openCheckout() {
                if (this.cart.length === 0) return;
                this.closeCart();
                document.getElementById('checkout-modal').classList.add('open');
                const summaryList = document.getElementById('checkout-summary-list');
                summaryList.innerHTML = '';
                this.cart.forEach(item => {
                    const row = document.createElement('div');
                    row.className = 'summary-item-line';
                    row.innerHTML = `
                        <span>${item.name} (x${item.quantity})</span>
                        <span>$${item.price * item.quantity}.00</span>
                    `;
                    summaryList.appendChild(row);
                });
                const subtotal = this.cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
                document.getElementById('checkout-summary-total').textContent = `$${subtotal.toFixed(2)}`;
            }
            closeCheckout() {
                document.getElementById('checkout-modal').classList.remove('open');
            }
            setupEventHandlers() {
                document.getElementById('cart-btn').addEventListener('click', () => this.openCart());
                document.getElementById('close-cart-btn').addEventListener('click', () => this.closeCart());
                document.getElementById('cart-overlay').addEventListener('click', (e) => {
                    if (e.target === document.getElementById('cart-overlay')) this.closeCart();
                });
                document.getElementById('add-to-cart-main').addEventListener('click', () => {
                    const finalPrice = this.config.basePrice + this.config.finishPriceAdd;
                    this.addToCart('headset-vr1', 'Aether VR-1 Custom', finalPrice, 'custom');
                });
                document.getElementById('btn-reset-cam').addEventListener('click', () => {
                    if (this.viewer) this.viewer.resetCamera();
                });  const autoRotateBtn = document.getElementById('btn-auto-rotate');
                autoRotateBtn.addEventListener('click', () => {
                    if (this.viewer) {
                        this.viewer.autoRotate = !this.viewer.autoRotate;
                        autoRotateBtn.classList.toggle('active', this.viewer.autoRotate);
                    }
                });
                document.querySelectorAll('.finish-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        document.querySelectorAll('.finish-btn').forEach(b => b.classList.remove('active'));
                        btn.classList.add('active');
                        this.config.finish = btn.dataset.finish;
                        this.config.finishPriceAdd = parseInt(btn.dataset.priceAdd || 0);
                        const finishLabelMap = {
                            metallic: 'Metallic Pro',
                            matte: 'Matte Stealth',
                            cyberpunk: 'Carbon Grid'
                        };
                        document.getElementById('selected-finish').textContent = finishLabelMap[this.config.finish] || this.config.finish;
                        this.updatePriceDisplay();
                        this.update3DViewer();
                    });
                });
                document.getElementById('checkout-btn').addEventListener('click', () => this.openCheckout());
                document.getElementById('close-checkout-btn').addEventListener('click', () => this.closeCheckout());
                // card input sync
                const cardNumInput = document.getElementById('card-num');
                const cardExpiryInput = document.getElementById('card-expiry');
                const cardNameInput = document.getElementById('checkout-name');
                cardNumInput.addEventListener('input', (e) => {
                    let value = e.target.value.replace(/\s+/g, '').replace(/[^0-9]/gi, '');
                    let formattedValue = '';
                    for (let i = 0; i < value.length; i++) {
                        if (i > 0 && i % 4 === 0) formattedValue += ' ';
                        formattedValue += value[i];
                    }
                    e.target.value = formattedValue;
                    document.getElementById('card-number-preview').textContent = formattedValue || '•••• •••• •••• ••••';
                });
                cardExpiryInput.addEventListener('input', (e) => {
                    let value = e.target.value.replace(/\s+/g, '').replace(/[^0-9]/gi, '');
                    if (value.length > 2) {
                        value = value.slice(0, 2) + '/' + value.slice(2, 4);
                    }
                    e.target.value = value;
                    document.getElementById('card-number-preview').textContent = value || 'MM/YY';
                });
                cardNameInput.addEventListener('input', (e) => {
                    document.getElementById('card-name-preview').textContent = e.target.value.toUpperCase() || 'YOUR NAME';
                });
                const checkoutForm = document.getElementById('checkout-form');
                checkoutForm.addEventListener('submit', (e) => {
                    e.preventDefault();
                    const submitBtn = checkoutForm.querySelector('.submit-btn');
                    const origText = submitBtn.innerHTML;
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = `<i data-lucide="loader" class="animate-spin"></i> Synchronizing Credentials...`;
                    if (window.lucide) window.lucide.createIcons();
                    setTimeout(() => {
                        const orderId = `ATH-${Math.floor(Math.random() * 90000) + 10000}-${String.fromCharCode(65 + Math.floor(Math.random()*26))}${String.fromCharCode(65 + Math.floor(Math.random()*26))}`;
                        const cityVal = document.getElementById('checkout-city').value;
                        const totalVal = document.getElementById('checkout-summary-total').textContent;
                        document.getElementById('receipt-ref').textContent = orderId;
                        document.getElementById('receipt-node').textContent = cityVal || 'Global Delivery Grid';
                        document.getElementById('receipt-total').textContent = totalVal;
                        this.closeCheckout();
                        this.clearCart();
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = origText;
                        checkoutForm.reset();
                        document.getElementById('success-modal').classList.add('open');
                    }, 2000);
                });
                document.getElementById('success-close-btn').addEventListener('click', () => {
                    document.getElementById('success-modal').classList.remove('open');
                });
                document.querySelectorAll('.nav-links a').forEach(link => {
                    link.addEventListener('click', () => {
                        document.querySelectorAll('.nav-links a').forEach(l => l.classList.remove('active'));
                        link.classList.add('active');
                    });
                });
            }
        }
        window.addEventListener('DOMContentLoaded', () => {
            new App();
        });
    </script>
</body>
</html>
