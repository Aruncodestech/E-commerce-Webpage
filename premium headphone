<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AETHER Audio // Premium Standalone 3D Cyber-Headphones</title>
    <!-- Modern Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        /* ==========================================================================
           AETHER AUDIO DESIGN SYSTEM & BASE STYLES
           ========================================================================== */
        :root {
            /* Color Palette */
            --bg-base: #080a0f;
            --bg-surface: rgba(16, 20, 30, 0.45);
            --bg-surface-solid: #10141e;
            --border-color: rgba(255, 255, 255, 0.08);
            --border-glow: rgba(255, 255, 255, 0.15);
            
            --text-primary: #f3f4f6;
            --text-secondary: #9ca3af;
            --text-muted: #6b7280;
            
            /* Neon Accents */
            --accent-cyan: #00f0ff;
            --accent-cyan-glow: rgba(0, 240, 255, 0.35);
            --accent-purple: #bd00ff;
            --accent-purple-glow: rgba(189, 0, 255, 0.35);
            --accent-emerald: #00ff66;
            --accent-emerald-glow: rgba(0, 255, 102, 0.35);
            --accent-ruby: #ff0055;
            --accent-ruby-glow: rgba(255, 0, 85, 0.35);
            
            /* Active state placeholder */
            --accent-active: var(--accent-cyan);
            --accent-active-glow: var(--accent-cyan-glow);
            /* Fonts */
            --font-display: 'Space Grotesk', sans-serif;
            --font-body: 'Outfit', sans-serif;
            
            /* Borders & Radius */
            --radius-sm: 8px;
            --radius-md: 16px;
            --radius-lg: 24px;
            --radius-circle: 50%;
            
            /* Shadows & Glass */
            --glass-blur: blur(16px);
            --shadow-premium: 0 20px 50px rgba(0, 0, 0, 0.5);
            --transition-smooth: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
            --transition-fast: all 0.2s ease;
        }
        /* Base Resets */
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        html {
            scroll-behavior: smooth;
            font-size: 16px;
        }
        body {
            background-color: var(--bg-base);
            color: var(--text-primary);
            font-family: var(--font-body);
            overflow-x: hidden;
            line-height: 1.6;
            min-height: 100vh;
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(189, 0, 255, 0.05) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(0, 240, 255, 0.05) 0%, transparent 40%);
            background-attachment: fixed;
        }
        /* Scrollbar Customization */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: var(--bg-base);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--bg-surface-solid);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
        }
        ::-webkit-scrollbar-thumb:hover {
            background: var(--text-muted);
        }
        /* Typography Utility */
        h1, h2, h3, h4 {
            font-family: var(--font-display);
            font-weight: 700;
            letter-spacing: -0.02em;
        }
        a {
            color: inherit;
            text-decoration: none;
            transition: var(--transition-fast);
        }
        button {
            background: none;
            border: none;
            font-family: inherit;
            cursor: pointer;
            outline: none;
        }
        /* Glassmorphism Panel helper */
        .glass {
            background: var(--bg-surface);
            backdrop-filter: var(--glass-blur);
            -webkit-backdrop-filter: var(--glass-blur);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-premium);
            transition: var(--transition-smooth);
        }
        .glass:hover {
            border-color: var(--border-glow);
        }
        /* Loader Styles */
        .loader-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: var(--bg-base);
            z-index: 9999;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: opacity 0.8s cubic-bezier(0.25, 0.8, 0.25, 1);
        }
        .loader-content {
            text-align: center;
        }
        .loader-logo {
            font-family: var(--font-display);
            font-size: 2.5rem;
            font-weight: 700;
            letter-spacing: 0.5em;
            margin-bottom: 2rem;
            color: var(--text-primary);
            text-shadow: 0 0 15px rgba(255, 255, 255, 0.2);
        }
        .loader-ring {
            width: 80px;
            height: 80px;
            border: 2px dashed rgba(0, 240, 255, 0.2);
            border-radius: 50%;
            position: relative;
            margin: 0 auto 2rem auto;
            animation: rotate 10s linear infinite;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .loader-core {
            width: 40px;
            height: 40px;
            background: radial-gradient(circle, var(--accent-cyan) 0%, transparent 70%);
            border-radius: 50%;
            animation: pulse 1.5s ease-in-out infinite alternate;
        }
        .loader-status {
            font-family: var(--font-display);
            font-size: 0.85rem;
            letter-spacing: 0.1em;
            color: var(--text-secondary);
            text-transform: uppercase;
            margin-bottom: 0.5rem;
        }
        .loader-percentage {
            font-family: var(--font-display);
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--accent-cyan);
            text-shadow: 0 0 10px var(--accent-cyan-glow);
        }
        /* Navbar */
        .navbar {
            position: fixed;
            top: 1.5rem;
            left: 5%;
            width: 90%;
            height: 4.5rem;
            padding: 0 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000;
            border-radius: var(--radius-md);
        }
        .logo {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-family: var(--font-display);
            font-size: 1.25rem;
            font-weight: 700;
            letter-spacing: 0.15em;
        }
        .logo-icon {
            color: var(--accent-active);
            filter: drop-shadow(0 0 8px var(--accent-active-glow));
            transition: var(--transition-smooth);
        }
        .nav-links {
            display: flex;
            gap: 2.5rem;
        }
        .nav-links a {
            font-size: 0.95rem;
            color: var(--text-secondary);
            letter-spacing: 0.05em;
            font-weight: 500;
            position: relative;
            padding: 0.25rem 0;
        }
        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--accent-active);
            box-shadow: 0 0 8px var(--accent-active-glow);
            transition: var(--transition-fast);
        }
        .nav-links a:hover,
        .nav-links a.active {
            color: var(--text-primary);
        }
        .nav-links a.active::after,
        .nav-links a:hover::after {
            width: 100%;
        }
        .nav-actions {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        .icon-btn {
            width: 2.75rem;
            height: 2.75rem;
            border-radius: var(--radius-sm);
            display: flex;
            justify-content: center;
            align-items: center;
            color: var(--text-primary);
            position: relative;
        }
        .icon-btn:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.2);
        }
        .cart-count {
            position: absolute;
            top: -5px;
            right: -5px;
            background: var(--accent-active);
            color: #000;
            font-size: 0.75rem;
            font-weight: 800;
            width: 1.25rem;
            height: 1.25rem;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 0 8px var(--accent-active-glow);
            transition: var(--transition-smooth);
        }
        /* Layout Core */
        .main-content {
            padding-top: 8rem;
            max-width: 1440px;
            margin: 0 auto;
            width: 90%;
        }
        .section {
            padding: 2rem 0 4rem 0;
            min-height: calc(100vh - 8rem);
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .grid-container {
            display: grid;
            grid-template-columns: 320px 1fr 340px;
            gap: 2rem;
            align-items: stretch;
        }
        @media (max-width: 1200px) {
            .grid-container {
                grid-template-columns: 1fr 1fr;
            }
            .canvas-container {
                grid-column: 1 / -1;
                height: 500px;
                order: -1;
            }
        }
        @media (max-width: 768px) {
            .grid-container {
                grid-template-columns: 1fr;
            }
            .navbar {
                padding: 0 1rem;
            }
            .nav-links {
                display: none;
            }
        }
        .panel {
            padding: 2.5rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        /* Hero Title Panel */
        .product-info {
            justify-content: center;
            gap: 1.5rem;
        }
        .tag {
            align-self: flex-start;
            font-family: var(--font-display);
            font-size: 0.75rem;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            padding: 0.35rem 0.85rem;
            border-radius: var(--radius-sm);
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-color);
            color: var(--accent-active);
            text-shadow: 0 0 5px var(--accent-active-glow);
        }
        .product-title {
            font-size: 3rem;
            line-height: 1.1;
            background: linear-gradient(135deg, #fff 40%, var(--accent-active) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .product-description {
            color: var(--text-secondary);
            font-size: 0.95rem;
            line-height: 1.7;
        }
        .mini-specs {
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
            margin: 1rem 0;
            border-top: 1px solid var(--border-color);
            border-bottom: 1px solid var(--border-color);
            padding: 1.25rem 0;
        }
        .mini-spec-item {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        .mini-spec-item i {
            color: var(--accent-active);
            filter: drop-shadow(0 0 5px var(--accent-active-glow));
        }
        .mini-spec-item .label {
            display: block;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
        }
        .mini-spec-item .value {
            font-size: 0.9rem;
            font-weight: 600;
        }
        .pricing-container {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            margin-top: 1rem;
        }
        .price-wrapper {
            font-family: var(--font-display);
            font-weight: 700;
            display: flex;
            align-items: flex-start;
        }
        .price-wrapper .currency {
            font-size: 1.5rem;
            margin-top: 0.25rem;
            color: var(--text-secondary);
        }
        .price-wrapper .price {
            font-size: 3.5rem;
            line-height: 1;
            color: var(--text-primary);
        }
        .price-wrapper .cents {
            font-size: 1.25rem;
            margin-top: 0.5rem;
            color: var(--text-secondary);
        }
        /* Button Premium styling */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            padding: 1rem 2rem;
            border-radius: var(--radius-sm);
            font-family: var(--font-display);
            font-size: 0.95rem;
            font-weight: 600;
            letter-spacing: 0.02em;
            transition: var(--transition-smooth);
        }
        .btn-primary {
            background: var(--accent-active);
            color: #000;
            position: relative;
            overflow: hidden;
            z-index: 1;
        }
        .btn-primary::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 0;
            height: 100%;
            background: #fff;
            z-index: -1;
            transition: var(--transition-smooth);
        }
        .btn-primary:hover {
            color: #000;
            box-shadow: 0 0 25px var(--accent-active-glow);
            transform: translateY(-2px);
        }
        .btn-primary:hover::before {
            width: 100%;
        }
        .btn-glow {
            box-shadow: 0 0 15px var(--accent-active-glow);
        }
        .btn-block {
            width: 100%;
        }
        /* 3D Canvas Panel */
        .canvas-container {
            position: relative;
            padding: 0;
            overflow: hidden;
            min-height: 500px;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        #canvas-3d-target {
            width: 100%;
            height: 100%;
            position: absolute;
            top: 0;
            left: 0;
            outline: none;
        }
        .canvas-controls {
            position: absolute;
            top: 1.5rem;
            right: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            z-index: 10;
        }
        .glass-control-btn {
            width: 2.5rem;
            height: 2.5rem;
            border-radius: var(--radius-sm);
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid var(--border-color);
            backdrop-filter: blur(8px);
            color: var(--text-secondary);
            display: flex;
            justify-content: center;
            align-items: center;
            transition: var(--transition-fast);
        }
        .glass-control-btn:hover {
            color: var(--text-primary);
            border-color: rgba(255, 255, 255, 0.2);
            background: rgba(0, 0, 0, 0.5);
        }
        .glass-control-btn.active {
            color: var(--accent-active);
            border-color: var(--accent-active);
            box-shadow: 0 0 10px var(--accent-active-glow);
        }
        .canvas-hint {
            position: absolute;
            bottom: 1.5rem;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 0, 0, 0.45);
            backdrop-filter: blur(8px);
            border: 1px solid var(--border-color);
            padding: 0.5rem 1rem;
            border-radius: 50px;
            font-size: 0.75rem;
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            pointer-events: none;
            white-space: nowrap;
        }
        .canvas-hint i {
            animation: pulse 1.5s infinite alternate;
        }
        /* Customizer Panel */
        .customizer-controls {
            gap: 1.5rem;
            justify-content: center;
        }
        .section-subtitle {
            font-size: 1.5rem;
            margin-bottom: 0.25rem;
        }
        .section-desc {
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-bottom: 1rem;
        }
        .customizer-group {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 1.25rem;
        }
        .customizer-group:last-of-type {
            border-bottom: none;
        }
        .group-header {
            display: flex;
            justify-content: space-between;
            font-size: 0.85rem;
        }
        .group-title {
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-secondary);
        }
        .selected-value {
            color: var(--accent-active);
            font-weight: 500;
            transition: var(--transition-fast);
        }
        /* Finish selector options */
        .finish-selector {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.5rem;
        }
        .finish-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem 0.5rem;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-color);
            font-size: 0.75rem;
            color: var(--text-secondary);
            transition: var(--transition-fast);
            background: rgba(255, 255, 255, 0.01);
        }
        .finish-btn:hover {
            border-color: rgba(255, 255, 255, 0.2);
            color: var(--text-primary);
        }
        .finish-btn.active {
            border-color: var(--accent-active);
            color: var(--text-primary);
            background: rgba(255, 255, 255, 0.03);
            box-shadow: inset 0 0 10px rgba(0, 240, 255, 0.05);
        }
        .finish-preview {
            width: 1.5rem;
            height: 1.5rem;
            border-radius: 50%;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .metallic-preview {
            background: linear-gradient(135deg, #a1a1aa 0%, #3f3f46 100%);
        }
        .matte-preview {
            background: #27272a;
        }
        .cyberpunk-preview {
            background: repeating-linear-gradient(45deg, #18181b, #18181b 4px, #3f3f46 4px, #3f3f46 8px);
        }
        /* Color swatch lists */
        .color-swatches {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
        }
        .swatch {
            width: 2.25rem;
            height: 2.25rem;
            border-radius: 50%;
            border: 2px solid transparent;
            padding: 2px;
            transition: var(--transition-fast);
            position: relative;
        }
        .swatch-inner {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            display: block;
            box-shadow: inset 0 2px 4px rgba(0,0,0,0.4);
        }
        .swatch:hover {
            transform: scale(1.1);
        }
        .swatch.active {
            border-color: var(--accent-active);
            box-shadow: 0 0 10px var(--accent-active-glow);
        }
        /* Specs Section Styling */
        .specs-section {
            margin-top: 6rem;
            margin-bottom: 4rem;
        }
        .glass-section {
            background: rgba(16, 20, 30, 0.25);
            backdrop-filter: var(--glass-blur);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            padding: 4rem 3rem;
        }
        .text-center {
            text-align: center;
        }
        .section-header {
            margin-bottom: 3.5rem;
        }
        .section-title {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
        }
        .section-subtitle-text {
            color: var(--text-secondary);
            font-size: 1.1rem;
        }
        .specs-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 2rem;
        }
        .spec-card {
            padding: 2.5rem 2rem;
            text-align: left;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }
        .spec-icon-wrapper {
            width: 3.5rem;
            height: 3.5rem;
            border-radius: var(--radius-sm);
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border-color);
            display: flex;
            justify-content: center;
            align-items: center;
            color: var(--accent-active);
            transition: var(--transition-smooth);
        }
        .spec-card:hover .spec-icon-wrapper {
            background: var(--accent-active);
            color: #000;
            box-shadow: 0 0 15px var(--accent-active-glow);
            transform: translateY(-2px);
        }
        .spec-card h3 {
            font-size: 1.25rem;
        }
        .spec-card p {
            font-size: 0.9rem;
            color: var(--text-secondary);
            line-height: 1.6;
        }
        /* Accessory Catalog Section */
        .catalog-section {
            margin-top: 4rem;
            margin-bottom: 6rem;
        }
        .catalog-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
        }
        .catalog-card {
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
        }
        .card-img-wrapper {
            height: 200px;
            background: rgba(255, 255, 255, 0.01);
            display: flex;
            justify-content: center;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
            position: relative;
            padding: 1.5rem;
        }
        .accessory-svg {
            width: auto;
            height: 80px;
            filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.4));
            transition: var(--transition-smooth);
        }
        .catalog-card:hover .accessory-svg {
            transform: scale(1.15) rotate(5deg);
        }
        .card-body {
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            flex-grow: 1;
        }
        .card-title {
            font-size: 1.15rem;
        }
        .card-desc {
            font-size: 0.85rem;
            color: var(--text-secondary);
            line-height: 1.5;
            flex-grow: 1;
        }
        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid var(--border-color);
            padding-top: 1rem;
            margin-top: 0.5rem;
        }
        .card-price {
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 1.25rem;
        }
        .card-btn {
            width: 2.5rem;
            height: 2.5rem;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-color);
            display: flex;
            justify-content: center;
            align-items: center;
            color: var(--text-primary);
            transition: var(--transition-fast);
        }
        .card-btn:hover {
            background: var(--accent-active);
            color: #000;
            border-color: var(--accent-active);
            box-shadow: 0 0 10px var(--accent-active-glow);
        }
        /* Cart Overlay & Sidebar */
        .cart-overlay-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(8px);
            z-index: 2000;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.5s cubic-bezier(0.25, 0.8, 0.25, 1);
        }
        .cart-overlay-container.open {
            opacity: 1;
            pointer-events: all;
        }
        .cart-panel {
            position: absolute;
            top: 0;
            right: 0;
            width: 420px;
            height: 100%;
            border-radius: 0;
            border-left: 1px solid var(--border-color);
